<?xml version='1.1' encoding='UTF-8'?>
<!--
  Pipeline job definition for PhishGuard, kept in the repo so the job can be
  recreated exactly rather than clicked together from memory.

  Create it with:
      java -jar jenkins-cli.jar -s http://localhost:8080 -auth <user>:<token> \
          create-job phishguard < jenkins/phishguard-job.xml

  or paste the same settings into New Item -> Pipeline (see jenkins/README.md).

  The SCM url points at the LOCAL clone, so a build works with no network and
  no credentials. Swap it for the GitHub URL once the webhook is in use.
-->
<flow-definition plugin="workflow-job">
  <description>PhishGuard: train -&gt; accuracy gate -&gt; test -&gt; scan -&gt; deploy (PS-4 mini project)</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <jenkins.model.BuildDiscarderProperty>
      <strategy class="hudson.tasks.LogRotator">
        <daysToKeep>-1</daysToKeep>
        <numToKeep>20</numToKeep>
        <artifactDaysToKeep>-1</artifactDaysToKeep>
        <artifactNumToKeep>-1</artifactNumToKeep>
      </strategy>
    </jenkins.model.BuildDiscarderProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps">
    <scm class="hudson.plugins.git.GitSCM" plugin="git">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <url>/Users/vaibhav/PS/phishguard</url>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/main</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="empty-list"/>
      <extensions/>
    </scm>
    <scriptPath>Jenkinsfile</scriptPath>
    <lightweight>false</lightweight>
  </definition>
  <disabled>false</disabled>
</flow-definition>
