{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "phishguard-flask",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["wsgi.py"],
      "port": 5000,
      "autoPort": true
    },
    {
      "name": "phishguard-dashboard",
      "runtimeExecutable": ".venv/bin/streamlit",
      "runtimeArgs": ["run", "dashboard/app.py", "--server.headless", "true"],
      "port": 8501,
      "autoPort": true
    }
  ]
}
